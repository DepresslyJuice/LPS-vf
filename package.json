{
  "name": "software-factory-courses-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para una app de cursos con NestJS, React y Vite.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run build -w @courses/shared && npm run start:dev -w @courses/backend",
    "dev:frontend": "npm run build -w @courses/shared && npm run dev -w @courses/frontend",
    "build:ui": "npm run build -w @courses/ui",
    "generate:module": "plop module",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:version": "supabase --version",
    "db:migration:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "plop": "^4.0.5"
  }
}
